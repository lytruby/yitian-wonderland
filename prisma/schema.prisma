generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ActionCard {
  id          String   @id @default(cuid())
  title       String
  description String
  minutes     Int
  energy      String
  focus       String
  category    String   @default("life")
  thread      String
  archivedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sessions    ActionSession[]
}

model ActionSession {
  id             String   @id @default(cuid())
  actionCardId   String
  actionCard     ActionCard @relation(fields: [actionCardId], references: [id], onDelete: Restrict)
  plannedMinutes Int
  elapsedSeconds Int      @default(0)
  status         String   @default("running")
  note           String?
  startedAt      DateTime @default(now())
  completedAt    DateTime?
  updatedAt      DateTime @updatedAt
}

model PrepItem {
  id             String         @id
  track          String
  section        String
  title          String
  description    String?
  sourceUrl      String?
  difficulty     String?
  status         String         @default("untouched")
  priority       String         @default("normal")
  notes          String         @default("")
  lastReviewedAt DateTime?
  sortOrder      Int
  evidence       PrepEvidence[]
  questions      InterviewQuestion[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([track, section])
}

model InterviewQuestion {
  id           String   @id @default(cuid())
  prepItemId   String
  prepItem     PrepItem @relation(fields: [prepItemId], references: [id], onDelete: Cascade)
  title        String
  prompt       String?
  code         String?
  language     String?
  answer       String   @default("")
  explanation  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([prepItemId])
}

model PrepEvidence {
  id         String   @id @default(cuid())
  prepItemId String
  prepItem   PrepItem @relation(fields: [prepItemId], references: [id], onDelete: Cascade)
  title      String
  url        String?
  note       String?
  createdAt  DateTime @default(now())
}
